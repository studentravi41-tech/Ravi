  </div>
</section>

<!-- SERVICES -->
<section id="services">
  <p class="section-label reveal">✦ What I Offer</p>
  <h2 class="section-title reveal">MY<br>SERVICES</h2>
  <p class="section-desc reveal">Professional graphic design services tailored for businesses, brands, and social media.</p>

  <div class="services-grid">
    <div class="service-card reveal">
      <div class="service-icon">🎨</div>
